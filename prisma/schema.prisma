// Bản 2 (cá nhân): docs/v2-spec.md.
// CHECK constraints and RLS live in the SQL migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===== Auth (Better Auth, username plugin; only the shop owner) =====

model User {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  emailVerified   Boolean  @default(false) @map("email_verified")
  image           String?
  username        String?  @unique
  displayUsername String?  @map("display_username")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions Session[]
  accounts Account[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

// ===== Shop =====

/// Single row (id = 1): contact links shown on the public catalog.
model ShopSettings {
  id           Int      @id @default(1)
  shopName     String   @default("Bích Ngọc Florist") @map("shop_name")
  phone        String?
  zaloPhone    String?  @map("zalo_phone")
  facebookUrl  String?  @map("facebook_url")
  messengerUrl String?  @map("messenger_url")
  tiktokUrl    String?  @map("tiktok_url")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("shop_settings")
}

// ===== Catalog =====

model Category {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @unique
  /// e.g. "BO": new products in this category get BO-001, BO-002...
  codePrefix String   @unique @map("code_prefix")
  sortOrder  Int      @default(0) @map("sort_order")
  isVisible  Boolean  @default(true) @map("is_visible")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@map("categories")
}

/// Last number handed out per code prefix (seeded from existing codes on first use).
model ProductCodeCounter {
  prefix  String @id
  lastSeq Int    @map("last_seq")

  @@map("product_code_counters")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  /// generated, never changes (also not when the category changes)
  code        String   @unique
  name        String
  categoryId  String   @map("category_id") @db.Uuid
  category    Category @relation(fields: [categoryId], references: [id])
  /// null = "Liên hệ báo giá"
  price       Int?
  size        String?
  color       String?
  description String?
  isVisible   Boolean  @default(true) @map("is_visible")
  isArchived  Boolean  @default(false) @map("is_archived")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  images     ProductImage[]
  variants   ProductVariant[]
  orderItems OrderItem[]

  @@index([categoryId, isVisible])
  @@map("products")
}

model ProductImage {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  product     Product  @relation(fields: [productId], references: [id])
  storagePath String   @map("storage_path")
  url         String
  sortOrder   Int      @default(0) @map("sort_order")
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model ProductVariant {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  price     Int
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  orderItems OrderItem[]

  @@index([productId, sortOrder])
  @@map("product_variants")
}

// ===== Customers & orders =====

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  /// normalized: 0xxxxxxxxx
  phone     String   @unique
  address   String?
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  orders Order[]

  @@map("customers")
}

enum OrderStatus {
  NEW
  DELIVERING
  COMPLETED
  CANCELLED
}

enum OrderChannel {
  FACEBOOK
  ZALO
  TIKTOK
  PHONE
  IN_STORE
}

enum ReceiveType {
  DELIVERY
  PICKUP
}

model Order {
  id               String       @id @default(uuid()) @db.Uuid
  code             String       @unique
  customerId       String       @map("customer_id") @db.Uuid
  customer         Customer     @relation(fields: [customerId], references: [id])
  recipientName    String       @map("recipient_name")
  recipientPhone   String       @map("recipient_phone")
  channel          OrderChannel
  receiveType      ReceiveType  @map("receive_type")
  deliveryAddress  String?      @map("delivery_address")
  /// deadline, Vietnam calendar date; the order sits on this day in the calendar
  deliveryDate     DateTime     @map("delivery_date") @db.Date
  /// "HH:mm"
  deliveryTimeFrom String?      @map("delivery_time_from")
  deliveryTimeTo   String?      @map("delivery_time_to")
  courierName      String?      @map("courier_name")
  subtotal         Int
  discount         Int          @default(0)
  shippingFee      Int          @default(0) @map("shipping_fee")
  total            Int
  deposit          Int          @default(0)
  cardMessage      String?      @map("card_message")
  note             String?
  status           OrderStatus  @default(NEW)
  deliveringAt     DateTime?    @map("delivering_at") @db.Timestamptz(3)
  completedAt      DateTime?    @map("completed_at") @db.Timestamptz(3)
  cancelledAt      DateTime?    @map("cancelled_at") @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  items OrderItem[]

  @@index([deliveryDate, status])
  @@index([status])
  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id                  String          @id @default(uuid()) @db.Uuid
  orderId             String          @map("order_id") @db.Uuid
  order               Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String          @map("product_id") @db.Uuid
  product             Product         @relation(fields: [productId], references: [id])
  productVariantId    String?         @map("product_variant_id") @db.Uuid
  productVariant      ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  productCodeSnapshot String  @map("product_code_snapshot")
  nameSnapshot        String  @map("name_snapshot")
  variantNameSnapshot String? @map("variant_name_snapshot")
  unitPriceSnapshot   Int     @map("unit_price_snapshot")
  /// added to each unit on top of the price snapshot (e.g. a bigger size the customer asked for)
  extraPrice          Int     @default(0) @map("extra_price")
  extraNote           String? @map("extra_note")
  qty                 Int
  note                String?
  sortOrder           Int     @default(0) @map("sort_order")

  @@index([orderId])
  @@index([productId])
  @@index([productVariantId])
  @@map("order_items")
}

model OrderCounter {
  day     DateTime @id @db.Date
  lastSeq Int      @map("last_seq")

  @@map("order_counters")
}
